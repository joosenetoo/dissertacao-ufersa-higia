    {
      "parameters": {
        "jsCode": "const op = String(\n  $('Normalizar Entrada').first().json.operation ?? ''\n)\n  .trim()\n  .replace(/\\r?\\n/g, '');\n\nconst data = $input.all().map(i => i.json);\n\nreturn [\n  {\n    json: {\n      ok: true,\n      operation: op,\n      count: data.length,\n      data\n    }\n  }\n];\n"
      },
