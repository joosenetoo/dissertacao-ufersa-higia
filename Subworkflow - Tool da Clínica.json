    {
      "parameters": {
        "jsCode": "const op = String($json.operation ?? '').trim().replace(/\\r?\\n/g, '');\n\nreturn [\n  {\n    json: {\n      ok: false,\n      operation: op,\n      error: op === \"get_exam_by_id\"\n        ? \"Para consultar um exame específico, informe o exam_id.\"\n        : \"Operação inválida ou não suportada.\",\n      allowed_operations: [\n        \"get_patient_by_cpf\",\n        \"list_upcoming_consultas_by_patient_cpf\",\n        \"list_consultas_by_date\",\n        \"list_exams_by_patient_cpf\",\n        \"get_exam_by_id\",\n        \"list_all_consultas\"\n      ]\n    }\n  }\n];\n"
      },
