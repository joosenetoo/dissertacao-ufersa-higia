    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  c.id AS consulta_id,\n  c.inicio,\n  c.fim,\n  c.status,\n  c.motivo,\n  c.observacoes,\n\n  p.id AS paciente_id,\n  p.nome AS paciente_nome,\n  p.cpf AS paciente_cpf,\n\n  m.id AS medico_id,\n  m.nome AS medico_nome,\n  m.especialidade,\n\n  f.id AS atendente_id,\n  f.nome AS atendente_nome\n\nFROM consultas c\nJOIN pacientes p ON p.id = c.paciente_id\nJOIN medicos m ON m.id = c.medico_id\nLEFT JOIN funcionarios f ON f.id = c.atendente_id\n\nWHERE p.cpf = '{{ $json.params.cpf }}'\n  AND c.inicio >= CONCAT(CURDATE(), ' 00:00:00')\n\nORDER BY c.inicio ASC\nLIMIT 20;\n",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        400,
        -128
      ],
      "id": "802639e0-c2f9-42d0-a405-28b6926011b9",
      "name": "list_upcoming_consultas_by_patient_cpf",
      "credentials": {
        "mySql": {
          "id": "USLQw9kNkxrHB6Wx",
          "name": "MySQL - Higia Clinica"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  e.id AS exame_id,\n  e.status,\n  e.nome_exame,\n  e.laboratorio,\n  e.data_solicitacao,\n  e.data_realizacao,\n  e.resultado_resumo,\n  e.url_laudo,\n  m.nome AS medico_nome,\n  c.id AS consulta_id,\n  c.inicio AS consulta_inicio\nFROM exames_paciente e\nJOIN pacientes p ON p.id = e.paciente_id\nLEFT JOIN medicos m ON m.id = e.medico_id\nLEFT JOIN consultas c ON c.id = e.consulta_id\nWHERE p.cpf = '{{ $json.params.cpf }}'\nORDER BY e.data_realizacao DESC, e.id DESC\nLIMIT 50;",
        "options": {}
      },
